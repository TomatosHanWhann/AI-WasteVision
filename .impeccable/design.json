  "narrative": {
    "northStar": "Forest green product workspace",
    "overview": "The shipped identity follows the approved green project plan: a deep forest shell, pale green ground and white working surfaces. Thai typography and restrained line icons keep the interface familiar and readable. Real photographs supply the visual content.\n\nThe interface is calm and practical. Borders and tonal insets separate tasks; compact labels sit beside generous image areas. Color communicates material class and uncertainty as well as brand identity. This record describes the implementation in `src/style.css`, `src/main.js` and `src/domain.js`; `docs/DIRECTION.md` contains the surface composition and interaction story.",
    "keyCharacteristics": [
      "Forest shell and pale green ground.",
      "Self-hosted Thai typography with moderate weight contrast.",
      "White bordered panels with softly rounded corners.",
      "Actual item photography and labelled material probabilities.",
      "Warm uncertainty feedback and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Labelled Color Rule",
        "body": "Pair class and uncertainty colors with text; probability bars also retain numeric scores.",
        "section": "colors"
      },
      {
        "name": "The Thai Reading Rule",
        "body": "Keep Noto Sans Thai across headings, labels and body; preserve the generous paragraph leading and visible labels on native fields.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "Use borders and tonal separation for normal panels; reserve the existing overlay shadow for the modal dialog.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use forest for the shell and analysis action, green for capture actions, and white bordered work panels.",
      "**Do** keep material labels and numeric scores alongside class colors.",
      "**Do** retain Thai field labels, visible focus and the upload alternative beside camera capture.",
      "**Do** preserve contained image previews, cropped sample thumbnails and actual photograph attribution.",
      "**Do** honor reduced motion for prediction reveal and result scrolling."
    ],
    "donts": [
      "**Don't** apply resting card shadows to the flat working panels.",
      "**Don't** substitute a new display family for the existing Thai heading face.",
      "**Don't** use the success-green prediction treatment for explicit model rejection.",
      "**Don't** turn informational material tags into selected filter controls without implementing that behavior."
    ]
  }
}
