{
  "name": "ai-wastevision",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/copy-runtime.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src worker db tests scripts vite.config.js drizzle.config.js",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply wastevision --local"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.2.5",
    "drizzle-orm": "0.45.2",
    "lucide": "0.468.0",
    "onnxruntime-web": "1.23.2",
    "qrcode": "1.5.4"
  },
  "overrides": {"@esbuild-kit/core-utils":{"esbuild":"0.28.1"}},
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "drizzle-kit": "0.31.10",
    "prettier": "3.6.2",
    "vite": "7.3.8",
    "wrangler": "4.166.0"
  }
}
